# ═══════════════════════════════════════════════════════
# MORBISE SERVER — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════

# PORT — the port the server listens on
# Railway / Render set this automatically. Local dev: 3000
PORT=3000

# BASE_URL — your public domain (no trailing slash)
# This is what gets put in QR codes and join links
# Examples:
#   https://morbise.app
#   https://api.morbise.app
#   https://morbise-server.railway.app
BASE_URL=https://morbise.app

# DB_PATH — where the SQLite database file is stored
# Leave as default for Railway (writable /data volume recommended)
DB_PATH=./morbise.db

# NODE_ENV
NODE_ENV=production
